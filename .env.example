APP_NAME=template-go
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:password@localhost:5432/template_go?sslmode=disable
TRUST_IDENTITY_HEADER=true
# Host port for the Postgres container; change it if 5432 is taken.
POSTGRES_PORT=5432
# Product JWT checks. Set all three to require a Bearer credential verified
# against the JWKS document instead of the x-user-id header. Leave empty for
# local work with TRUST_IDENTITY_HEADER=true.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
