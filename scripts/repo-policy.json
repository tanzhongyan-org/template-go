{
  "layout": {
    "allow": [
      ".agents",
      ".ast-grep",
      ".claude",
      ".gemini",
      ".github",
      "api",
      "clients",
      "cmd",
      "docs",
      "internal",
      "scripts",
      "sql"
    ],
    "forbid": [
      "CLAUDE.md",
      "**/CLAUDE.md",
      "CLAUDE.local.md",
      "GEMINI.md",
      "**/GEMINI.md",
      ".cursorrules",
      ".github/copilot-instructions.md"
    ]
  },
  "docs": {
    "exclude": [
      "docs/plans/**",
      "docs/specs/**",
      "docs/archive/**",
      ".agents/**"
    ],
    "externalPrefixes": [
      "workflow/",
      "shared/"
    ],
    "ignorePaths": [
      "bin/server"
    ],
    "envExample": ".env.example",
    "envDocumentedIn": "README.md"
  },
  "dependencies": {
    "ledger": "docs/dependencies.md",
    "manifests": [
      "go.mod"
    ]
  },
  "versions": [
    {
      "name": "postgres",
      "sources": [
        {
          "file": "compose.yaml",
          "pattern": "image:\\s*postgres:(\\S+)"
        }
      ]
    }
  ]
}
