{
  "layout": {
    "allow": [
      ".agents",
      ".ast-grep",
      ".ast-grep/rules",
      ".ast-grep/tests",
      ".claude",
      ".gemini",
      ".github",
      ".github/ISSUE_TEMPLATE",
      ".github/rulesets",
      ".github/workflows",
      "cmd",
      "cmd/server",
      "docs",
      "docs/decisions",
      "docs/plans",
      "docs/specs",
      "docs/archive",
      "docs/archive/**",
      "internal",
      "internal/config",
      "internal/db",
      "internal/handler",
      "scripts",
      "sql"
    ]
  },
  "docs": {
    "exclude": ["docs/plans/**", "docs/specs/**", "docs/archive/**", ".agents/**"],
    "externalPrefixes": ["workflow/", "shared/"],
    "ignorePaths": ["bin/server"],
    "envExample": ".env.example",
    "envDocumentedIn": "README.md"
  },
  "dependencies": {
    "ledger": "docs/dependencies.md",
    "manifests": ["go.mod"]
  },
  "versions": [
    {
      "name": "postgres",
      "sources": [
        { "file": "compose.yaml", "pattern": "image:\\s*postgres:(\\S+)" },
        { "file": ".github/workflows/ci.yml", "pattern": "image:\\s*postgres:(\\S+)" },
        { "file": ".github/workflows/dast.yml", "pattern": "image:\\s*postgres:(\\S+)" }
      ]
    }
  ]
}
